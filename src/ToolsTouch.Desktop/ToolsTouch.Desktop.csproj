<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ToolsTouch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.2</Version>
    <!-- This explicit DPAPI reference is also supplied by newer Windows desktop SDKs. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ToolsTouch.Application/ToolsTouch.Application.csproj" />
    <ProjectReference Include="../ToolsTouch.Infrastructure/ToolsTouch.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" /></ItemGroup>
</Project>
