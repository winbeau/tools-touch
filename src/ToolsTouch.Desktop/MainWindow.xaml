<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:pages="clr-namespace:ToolsTouch.Desktop.Pages" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolsTouch.Desktop.MainWindow" Title="Tools Touch · 研究与申请工作台" Width="1360" Height="900" MinWidth="1040" MinHeight="720" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="{StaticResource BodySize}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackToProfessorsCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <CollectionViewSource x:Key="NavigationGroups" Source="{Binding Navigation}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Group" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </Window.Resources>
  <AdornerDecorator>
    <Grid Background="{StaticResource CanvasBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
        <DockPanel>
          <TextBlock Text="TOOLS TOUCH" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="研究与申请工作台" Style="{StaticResource Caption}" Margin="16,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SignedInAccount}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" />
        </DockPanel>
      </Border>
      <Grid Grid.Row="1">
        <Border x:Name="SignInPanel" Background="White" CornerRadius="{StaticResource SurfaceRadius}" Padding="40" Visibility="{Binding NeedsSignIn, Converter={StaticResource BoolVisibility}}" Margin="24">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="使用 Gmail 登录 Tools Touch" FontSize="28" FontWeight="SemiBold" Foreground="#182B3A" Margin="0,0,0,16" />
              <TextBlock Text="首次使用请先登录。这个 Gmail 既是你的应用账号，也是之后投递邮件的发件邮箱。" FontSize="16" Margin="0,0,0,20" />
              <Button Content="使用 Google 登录" Command="{Binding ConnectGmailCommand}" FontSize="16" Padding="24,14" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
              <CheckBox Content="自动打开默认浏览器" IsChecked="{Binding AutoOpenLoginBrowser}" Margin="0,8" />
              <Button Content="复制 Gmail 登录链接" Command="{Binding CopyGmailLoginUrlCommand}" HorizontalAlignment="Left" Style="{StaticResource TextButton}" />
              <Button Content="打开诊断日志" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left" Style="{StaticResource TextButton}" />
              <Button Content="取消登录" Command="{Binding CancelGmailCommand}" HorizontalAlignment="Left" Style="{StaticResource TextButton}" />
              <TextBlock Text="{Binding GmailProgress}" Foreground="#167D8D" Margin="0,8,0,16" />
              <TextBlock Text="授权完成后自动进入工作台，下次打开保留登录。发送邮件前仍需你逐封确认。" Foreground="#526774" Margin="0,0,0,20" />
              <Expander Header="开发者连接配置" Visibility="{Binding ShowGoogleSetup, Converter={StaticResource BoolVisibility}}">
                <StackPanel Margin="0,12">
                  <TextBlock Text="{Binding GmailClientName}" />
                  <TextBlock Text="源码或开发版本可在此导入 Google 桌面 OAuth 客户端配置。官方安装版由发布者预置，普通用户无需配置。" Margin="0,8" />
                  <Button Content="导入 Google 客户端配置" Command="{Binding ImportGoogleClientCommand}" HorizontalAlignment="Left" />
                  <Button Content="打开诊断日志" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left" Style="{StaticResource TextButton}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Grid x:Name="WorkspacePanel" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,8">
            <ListBox x:Name="WorkspaceNavigation" ItemsSource="{Binding Source={StaticResource NavigationGroups}}" SelectedValuePath="Id" SelectedValue="{Binding SelectedNavigationPage, Mode=TwoWay}" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="工作区导航">
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="10,12,0,6" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Grid Grid.Column="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource SurfaceRadius}" Padding="16">
              <TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}" BorderThickness="0" Padding="0">
                <TabControl.Template>
                  <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                  </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="工作概览">
                  <pages:DashboardPage x:Name="DashboardView" />
                </TabItem>
                <TabItem Header="发现导师">
                  <pages:DiscoverPage x:Name="DiscoverView" />
                </TabItem>
                <TabItem Header="本地导师库">
                  <pages:ProfessorsPage x:Name="ProfessorsView" />
                </TabItem>
                <TabItem Header="导师详情">
                  <pages:ProfessorDetailPage x:Name="ProfessorDetailView" />
                </TabItem>
                <TabItem Header="邮件工作区">
                  <pages:OutreachPage x:Name="OutreachView" />
                </TabItem>
                <TabItem Header="申请记录">
                  <pages:ApplicationsPage x:Name="ApplicationsView" />
                </TabItem>
                <TabItem Header="表格记录">
                  <pages:RecordsPage x:Name="RecordsView" />
                </TabItem>
                <TabItem Header="资料与账户">
                  <pages:SettingsPage x:Name="SettingsView" />
                </TabItem>
                <TabItem Header="招生窗口">
                  <pages:AdmissionsPage x:Name="AdmissionsView" />
                </TabItem>
                <TabItem Header="导师目录与覆盖">
                  <pages:FacultyPage x:Name="FacultyView" />
                </TabItem>
                <TabItem Header="推荐中心">
                  <pages:RecommendationsPage x:Name="RecommendationsView" />
                </TabItem>
              </TabControl>
            </Border>
          </Grid>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" MaxHeight="48" ToolTip="{Binding Status}" />
            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0" />
          </StackPanel>
          <WrapPanel Grid.Column="1" Margin="24,0,0,0">
            <TextBlock Text="{Binding ComponentStatus}" Style="{StaticResource Caption}" MaxWidth="320" VerticalAlignment="Center" ToolTip="{Binding ComponentStatus}" />
            <ProgressBar Width="56" Height="3" IsIndeterminate="True" Margin="8,0" Visibility="{Binding ComponentLoading, Converter={StaticResource BoolVisibility}}" />
            <Button Content="重试加载" Command="{Binding ConnectAgentCommand}" Style="{StaticResource TextButton}" Margin="8,0,0,0" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
  </AdornerDecorator>
</Window>
