<Window x:Class="ToolsTouch.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tools Touch · Research &amp; Outreach" Width="1280" Height="850" MinWidth="1000" MinHeight="680" Background="#F5F7F9" FontFamily="Segoe UI" FontSize="14">
  <DockPanel Margin="24">
    <Border DockPanel.Dock="Top" Padding="0,0,0,20"><StackPanel><TextBlock Text="TOOLS TOUCH" Foreground="#167D8D" FontWeight="Bold" FontSize="13"/><TextBlock Text="Research, with a personal direction." Foreground="#182B3A" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
    <Border DockPanel.Dock="Bottom" Background="#E6EEF3" Padding="12" Margin="0,12,0,0"><TextBlock Text="{Binding Status}"/></Border>
    <TabControl SelectedIndex="{Binding SelectedPage}" Background="White" BorderThickness="0" Padding="20">
      <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="16,12"/></Style></TabControl.Resources>
      <TabItem Header="Dashboard">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="工作概览" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,14,0,20" Foreground="#167D8D" FontSize="18"/>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"><DataGrid.Columns>
            <DataGridTextColumn Header="任务" Binding="{Binding Kind}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="110"/><DataGridTextColumn Header="错误 / 待处理原因" Binding="{Binding Error}" Width="*"/>
          </DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="从检查点继续" Command="{Binding ResumeCommand}"/><Button Content="取消当前任务" Command="{Binding CancelCommand}"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Discover">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="从一个研究方向开始" FontSize="24" FontWeight="SemiBold"/>
          <TextBox Grid.Row="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,16,0,8"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="发现导师" Command="{Binding DiscoverCommand}"/><Button Content="取消" Command="{Binding CancelCommand}"/><TextBlock Text="先查本地，再核实公开来源；没有 CV 也可以发现导师。" VerticalAlignment="Center" Margin="8,0"/></StackPanel>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Professors}" SelectedItem="{Binding SelectedProfessor}"><DataGrid.Columns><DataGridTextColumn Header="导师" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="机构" Binding="{Binding Institution}" Width="*"/></DataGrid.Columns></DataGrid>
            <DockPanel Grid.Column="1" Margin="16,0,0,0"><Button DockPanel.Dock="Bottom" Content="查看选中导师" Command="{Binding ViewProfessorCommand}"/><TextBlock DockPanel.Dock="Top" Text="执行进度" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding Activity}" BorderThickness="0"/></DockPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Professors">
        <DockPanel><TextBlock DockPanel.Dock="Top" Text="本地导师库" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Text="{Binding ProfessorFilter}" Width="340" ToolTip="按姓名、机构或证据关键词搜索"/><Button Content="筛选 / 刷新" Command="{Binding RefreshCommand}"/><Button Content="查看详情" Command="{Binding ViewProfessorCommand}"/></StackPanel>
          <DataGrid ItemsSource="{Binding Professors}" SelectedItem="{Binding SelectedProfessor}"><DataGrid.Columns><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="机构" Binding="{Binding Institution}" Width="*"/><DataGridTextColumn Header="公开邮箱" Binding="{Binding Email}" Width="*"/></DataGrid.Columns></DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Professor Detail">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="{Binding SelectedProfessor.Name, TargetNullValue=请先选择导师}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedProfessor.Institution}" Foreground="#167D8D" Margin="0,6"/></StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="打开主页" Command="{Binding OpenHomepageCommand}"/><Button Content="深入分析" Command="{Binding AnalyzeCommand}"/><Button Content="生成新草稿" Command="{Binding GenerateDraftCommand}"/></StackPanel>
          <TabControl Grid.Row="2" BorderThickness="0">
            <TabItem Header="研究与匹配"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBox Text="{Binding Analysis, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/><TextBlock Text="导师来源" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding SelectedProfessor.Evidence}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,10"><TextBlock Text="{Binding Claim}"/><TextBlock Text="{Binding Url}" Foreground="#167D8D"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="论文阅读"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><DockPanel Margin="0,12,12,0"><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="起始页码（每次最多 10 页）"/><TextBox Text="{Binding PaperStartPage}"/><Button Content="阅读所选页 / 摘要" Command="{Binding ReadPaperCommand}"/><Button Content="打开论文来源" Command="{Binding OpenPaperSourceCommand}"/></StackPanel><ListBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}" DisplayMemberPath="Title"/></DockPanel><TextBox Grid.Column="1" Text="{Binding PaperText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/></Grid></TabItem>
            <TabItem Header="投递历史"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="打开选中邮件" Command="{Binding OpenHistoryDraftCommand}" HorizontalAlignment="Left"/><DataGrid ItemsSource="{Binding ProfessorHistory}" SelectedItem="{Binding SelectedHistory}"><DataGrid.Columns><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="65"/><DataGridTextColumn Header="主题" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="发送状态" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="回复状态" Binding="{Binding ReplyState}" Width="110"/><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="210"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      <TabItem Header="Outreach">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ListBox ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft}" Margin="0,0,20,0" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,10"><TextBlock Text="{Binding Subject}" FontWeight="SemiBold"/><TextBlock Text="{Binding Recipient}" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding State}" Foreground="#167D8D"/><TextBlock Text="{Binding Version, StringFormat=' · 版本 {0}'}"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="邮件草稿" FontSize="24" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="收件人" Margin="0,12,0,0"/><TextBox Grid.Row="2" Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding DraftLocked}"/><TextBox Grid.Row="3" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" ToolTip="邮件主题" IsReadOnly="{Binding DraftLocked}"/>
            <TextBox Grid.Row="4" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding DraftLocked}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            <StackPanel Grid.Row="5"><TextBlock Text="{Binding Attachment, StringFormat='CV 附件：{0}'}"/><StackPanel Orientation="Horizontal"><Button Content="使用已确认 CV" Command="{Binding AttachCvCommand}"/><Button Content="移除附件" Command="{Binding RemoveAttachmentCommand}"/></StackPanel></StackPanel>
            <StackPanel Grid.Row="6" Orientation="Horizontal"><Button Content="保存修改" Command="{Binding SaveDraftCommand}"/><Button Content="Send · 确认发送" Command="{Binding SendCommand}"/><Button Content="核对发送结果" Command="{Binding ReconcileCommand}"/><Button Content="同步回复" Command="{Binding SyncRepliesCommand}"/></StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="850" HorizontalAlignment="Left">
          <TextBlock Text="账户与工作资料" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="OpenAI · Pi Provider" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,6"/><TextBlock Text="{Binding OpenAiStatus}"/>
          <StackPanel Orientation="Horizontal"><Button Content="启动 / 重新连接 Pi" Command="{Binding ConnectAgentCommand}"/><Button Content="OpenAI 登录" Command="{Binding LoginCommand}"/><Button Content="打开登录浏览器" Command="{Binding OpenLoginCommand}"/><Button Content="取消登录 / 任务" Command="{Binding CancelCommand}"/></StackPanel>
          <TextBlock Text="{Binding AuthPrompt}"/><TextBox Text="{Binding AuthReply, UpdateSourceTrigger=PropertyChanged}" ToolTip="仅在 Pi 请求手动授权码或选择项时填写"/><Button Content="提交 Pi 登录输入" Command="{Binding AuthReplyCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="模型"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Settings.Model}" MinWidth="350" Margin="0,4,0,14"/>
          <TextBlock Text="Gmail" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding GmailStatus}" Margin="0,6"/><TextBlock Text="Google 桌面 OAuth client JSON 文件"/><TextBox Text="{Binding Settings.GoogleClientFile}"/><Button Content="连接 / 重新连接 Gmail" Command="{Binding ConnectGmailCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="CV 与确认后的经历" FontSize="18" FontWeight="SemiBold"/><Button Content="导入 CV.pdf" Command="{Binding ImportCvCommand}" HorizontalAlignment="Left"/>
          <TextBox Text="{Binding CvText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="研究兴趣"/><TextBox Text="{Binding Interests}"/><TextBlock Text="项目经历"/><TextBox Text="{Binding Projects}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"/><TextBlock Text="技能"/><TextBox Text="{Binding Skills}"/><Button Content="确认并保存新资料版本" Command="{Binding ConfirmCvCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="资料保存在本机。进行研究和匹配时，选取的网页、论文片段及已确认经历会发送给当前 OpenAI Provider；Gmail 凭据不会交给 Agent。" Foreground="#526774" Margin="0,8,0,20"/>
          <Expander Header="Agent 与检索配置"><StackPanel Margin="0,12"><TextBlock Text="Node 可执行文件"/><TextBox Text="{Binding Settings.NodePath}"/><TextBlock Text="AgentHost index.js 路径"/><TextBox Text="{Binding Settings.AgentHostPath}"/><TextBlock Text="Brave API 密钥文件路径（密钥只由 C# 检索服务读取）"/><TextBox Text="{Binding Settings.SearchKeyFile}"/><TextBlock Text="每阶段工具调用上限"/><TextBox Text="{Binding Settings.MaxToolCalls}"/><TextBlock Text="每阶段超时（秒）"/><TextBox Text="{Binding Settings.StageTimeoutSeconds}"/><TextBlock Text="{Binding DataDirectory, StringFormat='本地数据：{0}'}"/></StackPanel></Expander>
          <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
