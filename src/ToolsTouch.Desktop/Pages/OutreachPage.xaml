<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:ToolsTouch.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolsTouch.Desktop.Pages.OutreachPage" Focusable="False">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" MinWidth="220" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="2.4*" MinWidth="420" />
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
        <TextBlock Text="草稿与邮件" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding Drafts.Count, StringFormat='共 {0} 封'}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft}" ui:EmptyState.Message="还没有草稿。进入导师详情，选择「生成新草稿」。">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Subject}" />
              <TextBlock Text="{Binding Recipient}" Style="{StaticResource Caption}" Margin="0,6,0,8" />
              <WrapPanel>
                <TextBlock Text="{Binding State, Converter={StaticResource DisplayLabel}}" Style="{StaticResource StatusLabel}" />
                <TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" Style="{StaticResource Caption}" Margin="8,4,0,0" />
              </WrapPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Row="2" Content="刷新列表" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
    </Grid>
    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" />
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="100" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Margin="0,0,0,12">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Notice}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedDraft.State}" Value="Unknown"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/></DataTrigger>
              <DataTrigger Binding="{Binding SelectedDraft.State}" Value="Failed"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="{Binding DraftEditorStatus}" FontSize="12" />
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding MailBusy, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="收件人" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding DraftLocked}" AutomationProperties.Name="收件人" />
      </Grid>
      <Grid Grid.Row="2" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="主题" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding DraftLocked}" AutomationProperties.Name="邮件主题" />
      </Grid>
      <TextBox Grid.Row="3" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding DraftLocked}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="16" AutomationProperties.Name="邮件正文" />
      <Grid Grid.Row="4" Margin="0,12,0,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Attachment, StringFormat='CV 附件：{0}'}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Attachment}" />
        <WrapPanel Grid.Row="1" ui:WorkspaceLayout.Gap="8" Margin="0,4,0,0">
          <Button Content="使用已确认 CV" Command="{Binding AttachCvCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
          <Button Content="移除附件" Command="{Binding RemoveAttachmentCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
        </WrapPanel>
      </Grid>
      <WrapPanel Grid.Row="5" ui:WorkspaceLayout.Gap="8">
        <Button Content="确认发送" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
        <Button Content="保存修改" Command="{Binding SaveDraftCommand}" VerticalAlignment="Center" />
        <Button Content="核对发送结果" Command="{Binding ReconcileCommand}" ToolTip="用于发送结果不确定的邮件；不会重新发送。" VerticalAlignment="Center" />
        <Button Content="同步回复" Command="{Binding SyncRepliesCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
      </WrapPanel>
    </Grid>
  </Grid>
</UserControl>
