<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:ToolsTouch.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolsTouch.Desktop.Pages.RecordsPage" Focusable="False">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="320" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <WrapPanel ui:WorkspaceLayout.Gap="8">
        <ComboBox ItemsSource="{Binding RecordGrid.CustomCollections}" SelectedItem="{Binding RecordGrid.SelectedCollection}" DisplayMemberPath="Name" Width="200" VerticalAlignment="Center" />
        <Button Content="新建记录" Command="{Binding RecordGrid.CreateRecordCommand}" VerticalAlignment="Center" />
        <Button Content="刷新" Command="{Binding RecordGrid.RefreshCommand}" VerticalAlignment="Center" />
      </WrapPanel>
      <DataGrid ItemsSource="{Binding RecordGrid.Rows}" SelectedItem="{Binding RecordGrid.SelectedRow}" AutoGenerateColumns="False" ui:EmptyState.Message="没有匹配记录。选择或新建表，添加记录或导入文件。" Grid.Row="1">
        <DataGrid.Columns>
          <DataGridTextColumn Header="记录 ID" Binding="{Binding RecordId}" Width="1.2*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="ToolTip" Value="{Binding RecordId}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="值摘要" Binding="{Binding DisplayValue}" Width="2*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="ToolTip" Value="{Binding DisplayValue}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="修订" Binding="{Binding Revision}" Width="70">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="ToolTip" Value="{Binding Revision}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" Text="{Binding RecordGrid.Status}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
    </Grid>
    <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <StackPanel Margin="0" ui:WorkspaceLayout.Gap="8">
          <TextBlock Text="字段编辑" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="字段" Margin="0,12,0,2" />
          <ComboBox ItemsSource="{Binding RecordGrid.Fields}" SelectedItem="{Binding RecordGrid.SelectedField}" DisplayMemberPath="DisplayName" Margin="0,4,0,8" IsEnabled="{Binding RecordGrid.HasSelectedRow}" />
          <TextBlock Text="字段值（关联、多选项使用 ID，以逗号分隔）" Margin="0,10,0,2" />
          <TextBox Text="{Binding RecordGrid.EditValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" Margin="0,4,0,8" IsEnabled="{Binding RecordGrid.HasSelectedField}" />
          <Button Content="保存单元格" Command="{Binding RecordGrid.SaveCellCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" />
          <TextBlock Text="先选择记录和字段，再编辑并保存。系统状态请在对应业务页面修改。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
        <Expander Header="筛选、排序与保存视图" Margin="0,12,0,0">
          <StackPanel Margin="0" ui:WorkspaceLayout.Gap="8">
            <TextBlock Text="视图" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding RecordGrid.Views}" SelectedItem="{Binding RecordGrid.SelectedView}" DisplayMemberPath="Name" VerticalAlignment="Center" />
            <TextBlock Text="视图名称" />
            <TextBox Text="{Binding RecordGrid.NewViewName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" ToolTip="视图名称" VerticalAlignment="Center" />
            <Button Content="保存视图" Command="{Binding RecordGrid.SaveViewCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock Text="筛选" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding RecordGrid.Fields}" SelectedItem="{Binding RecordGrid.SelectedFilterField}" DisplayMemberPath="DisplayName" VerticalAlignment="Center" />
            <TextBlock Text="比较方式" />
            <ComboBox ItemsSource="{Binding RecordGrid.FilterOperators}" SelectedItem="{Binding RecordGrid.FilterOperator}" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="筛选值" />
            <TextBox Text="{Binding RecordGrid.FilterValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" ToolTip="筛选值" VerticalAlignment="Center" />
            <Button Content="应用" Command="{Binding RecordGrid.ApplyFilterCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Button Content="清除" Command="{Binding RecordGrid.ClearFilterCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock Text="排序" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding RecordGrid.Fields}" SelectedItem="{Binding RecordGrid.SelectedSortField}" DisplayMemberPath="DisplayName" VerticalAlignment="Center" />
            <TextBlock Text="排序方向" />
            <ComboBox ItemsSource="{Binding RecordGrid.SortDirections}" SelectedItem="{Binding RecordGrid.SortDirection}" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Expander>
        <Expander Header="导入文件" Margin="0,12,0,0">
          <WrapPanel Margin="0" ui:WorkspaceLayout.Gap="8">
            <Button Content="选择 CSV/XLSX 并预览导入" Command="{Binding RecordGrid.PreviewImportCommand}" VerticalAlignment="Center" />
            <Button Content="提交导入批次" Command="{Binding RecordGrid.CommitImportCommand}" VerticalAlignment="Center" />
            <Button Content="取消导入批次" Command="{Binding RecordGrid.CancelImportCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RecordGrid.ImportSourcePath}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <TextBlock Text="{Binding RecordGrid.ImportStatus}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
          </WrapPanel>
        </Expander>
        <Expander Header="新建表与字段" Margin="0,12,0,0" IsExpanded="True">
          <StackPanel ui:WorkspaceLayout.Gap="8" Margin="0">
            <TextBlock Text="新建自定义表" />
            <TextBox Text="{Binding RecordGrid.NewCollectionName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" ToolTip="新建自定义表" VerticalAlignment="Center" />
            <Button Content="新建表" Command="{Binding RecordGrid.CreateCollectionCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock Text="字段 key" />
            <TextBox Text="{Binding RecordGrid.NewFieldKey, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" ToolTip="字段 key" VerticalAlignment="Center" />
            <TextBlock Text="字段名称" />
            <TextBox Text="{Binding RecordGrid.NewFieldName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" ToolTip="字段名称" VerticalAlignment="Center" />
            <TextBlock Text="字段类型" />
            <ComboBox ItemsSource="{Binding RecordGrid.FieldTypes}" SelectedItem="{Binding RecordGrid.NewFieldType}" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="新建字段" Command="{Binding RecordGrid.CreateFieldCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>
        <Expander Header="导入预览错误" IsExpanded="{Binding RecordGrid.HasImportErrors, Mode=OneWay}">
          <DataGrid ItemsSource="{Binding RecordGrid.ImportErrors}" Height="100" ui:EmptyState.Message="当前没有导入错误。">
            <DataGrid.Columns>
              <DataGridTextColumn Header="行" Binding="{Binding RowNumber}" Width="55">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="ToolTip" Value="{Binding RowNumber}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="180">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="ToolTip" Value="{Binding Code}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="列" Binding="{Binding SourceColumn}" Width="150">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="ToolTip" Value="{Binding SourceColumn}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="ToolTip" Value="{Binding Message}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
