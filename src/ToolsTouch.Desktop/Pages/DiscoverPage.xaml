<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:ToolsTouch.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolsTouch.Desktop.Pages.DiscoverPage" Focusable="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBox Grid.Row="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" Margin="0,16,0,8" />
    <WrapPanel Grid.Row="2" ui:WorkspaceLayout.Gap="8">
      <Button Content="发现导师" Command="{Binding DiscoverCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
      <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
      <TextBlock Text="先查本地，再核实公开来源；没有 CV 也可以发现导师。" VerticalAlignment="Center" Margin="8,0" />
    </WrapPanel>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Professors}" SelectedItem="{Binding SelectedProfessor}" ui:EmptyState.Message="没有匹配的导师。调整筛选条件，或前往「发现导师」检索。">
        <DataGrid.Columns>
          <DataGridTextColumn Header="导师" Binding="{Binding Name}" Width="*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="ToolTip" Value="{Binding Name}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="机构" Binding="{Binding Institution}" Width="*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="ToolTip" Value="{Binding Institution}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Column="1" Margin="16,0,0,0">
        <Button DockPanel.Dock="Bottom" Content="查看选中导师" Command="{Binding ViewProfessorCommand}" Style="{StaticResource PrimaryButton}" />
        <TextBlock DockPanel.Dock="Top" Text="执行进度" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding Activity}" BorderThickness="0" ui:EmptyState.Message="暂无记录。选择上方对象，或补充相关资料后刷新。" />
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
