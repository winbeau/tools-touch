<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:ToolsTouch.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolsTouch.Desktop.Pages.SettingsPage" Focusable="False">
  <TabControl BorderThickness="0">
    <TabItem Header="模型与邮箱">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,12,16,0" ui:WorkspaceLayout.Gap="8">
          <TextBlock Text="模型账户" Margin="0,18,0,6" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="服务商" />
          <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Name" IsEnabled="{Binding AccountControlsEnabled}" MinWidth="350" Margin="0,4,0,12" />
          <CheckBox Content="自动打开默认浏览器（关闭后可复制链接手动登录）" IsChecked="{Binding AutoOpenLoginBrowser}" Margin="0,8" />
          <TextBlock Text="授权方式" />
          <ComboBox ItemsSource="{Binding LoginMethods}" SelectedItem="{Binding SelectedLoginMethod}" DisplayMemberPath="Label" IsEnabled="{Binding AccountControlsEnabled}" Margin="0,4,0,12" />
          <StackPanel Visibility="{Binding ApiKeyRequired, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="API Key" />
            <PasswordBox x:Name="ProviderKeyBox" PasswordChanged="ProviderSecretChanged" IsEnabled="{Binding AccountControlsEnabled}" Padding="8" Margin="0,4,0,12" />
          </StackPanel>
          <TextBlock Text="{Binding ProviderStatus}" Foreground="{StaticResource AccentBrush}" />
          <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8" Visibility="{Binding AuthBusy, Converter={StaticResource BoolVisibility}}" />
          <WrapPanel ui:WorkspaceLayout.Gap="8">
            <Button Content="连接账户 / 保存密钥" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
            <Button Content="复制登录链接" Command="{Binding CopyLoginUrlCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
            <Button Content="重新打开授权页" Command="{Binding OpenLoginCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
            <Button Content="取消授权" Command="{Binding CancelAuthCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
          </WrapPanel>
          <TextBlock Text="{Binding AuthPrompt}" />
          <ComboBox ItemsSource="{Binding AuthChoices}" SelectedItem="{Binding SelectedAuthChoice}" DisplayMemberPath="Label" Visibility="{Binding HasAuthChoices, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,12" />
          <TextBox Text="{Binding AuthReply, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" Visibility="{Binding AuthText, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,8" />
          <PasswordBox x:Name="AuthSecretBox" PasswordChanged="AuthSecretChanged" Visibility="{Binding AuthSecret, Converter={StaticResource BoolVisibility}}" Padding="8" Margin="0,4,0,12" />
          <Button Content="提交授权信息" Command="{Binding AuthReplyCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="模型" />
          <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Settings.Model}" IsEnabled="{Binding AccountControlsEnabled}" MinWidth="350" Margin="0,4,0,14" />
          <TextBlock Text="Gmail" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding GmailStatus}" Margin="0,6" />
          <TextBlock Text="{Binding GmailProgress}" Foreground="{StaticResource AccentBrush}" Margin="0,6" />
          <WrapPanel ui:WorkspaceLayout.Gap="8">
            <Button Content="{Binding GmailConnectLabel}" Command="{Binding ConnectGmailCommand}" VerticalAlignment="Center" />
            <Button Content="重新授权 Gmail" Command="{Binding ReauthorizeGmailCommand}" VerticalAlignment="Center" />
            <Button Content="复制 Gmail 登录链接" Command="{Binding CopyGmailLoginUrlCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
            <Button Content="取消 Gmail 授权" Command="{Binding CancelGmailCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
          </WrapPanel>
          <TextBlock Text="Gmail 同时是应用账号与投递邮箱。官方安装版已经包含登录配置，你只需在 Google 页面选择自己的账号并授权。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" />
          <Expander Header="开发者连接配置" Visibility="{Binding ShowGoogleSetup, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
              <TextBlock Text="{Binding GmailClientName}" />
              <Button Content="导入 Google 客户端配置" Command="{Binding ImportGoogleClientCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="我的资料">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,12,16,0" ui:WorkspaceLayout.Gap="8">
          <TextBlock Text="CV 与确认后的经历" Style="{StaticResource SectionTitle}" />
          <Button Content="导入 CV.pdf" Command="{Binding ImportCvCommand}" HorizontalAlignment="Left" />
          <TextBox Text="{Binding CvText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8" />
          <TextBlock Text="研究兴趣" />
          <TextBox Text="{Binding Interests, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" Margin="0,4,0,8" />
          <TextBlock Text="项目经历" />
          <TextBox Text="{Binding Projects, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" Margin="0,4,0,8" />
          <TextBlock Text="技能" />
          <TextBox Text="{Binding Skills, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" Margin="0,4,0,8" />
          <Button Content="确认并保存新资料版本" Command="{Binding ConfirmCvCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
          <TextBlock Text="资料保存在本机。进行研究和匹配时，选取的网页、论文片段及已确认经历会发送给选定的模型服务商；Gmail 凭据不会交给模型。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="设置与诊断">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,12,16,0" ui:WorkspaceLayout.Gap="8">
          <Expander Header="检索与任务配置">
            <StackPanel Margin="0,12">
              <TextBlock Text="Brave API 密钥文件路径" />
              <TextBox Text="{Binding Settings.SearchKeyFile, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" Margin="0,4,0,8" />
              <TextBlock Text="每阶段工具调用上限" />
              <TextBox Text="{Binding Settings.MaxToolCalls, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" Margin="0,4,0,8" />
              <TextBlock Text="每阶段超时（秒）" />
              <TextBox Text="{Binding Settings.StageTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}" Margin="0,4,0,8" />
            </StackPanel>
          </Expander>
          <TextBlock Text="诊断日志" Margin="0,16,0,6" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="记录组件加载、授权阶段和错误代码。日志保留 14 天，不记录密钥、授权码、简历或邮件正文。" />
          <WrapPanel ui:WorkspaceLayout.Gap="8">
            <Button Content="打开日志目录" Command="{Binding OpenLogsCommand}" Style="{StaticResource TextButton}" VerticalAlignment="Center" />
            <Button Content="导出诊断日志" Command="{Binding ExportLogsCommand}" VerticalAlignment="Center" />
          </WrapPanel>
          <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
